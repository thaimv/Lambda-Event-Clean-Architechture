# jwt-authorizer Lambda — environment variables
# Set on AWS Lambda (Console / CD). For local simulator: copy to out/simulator/env.yml under `local:`.

# Runtime
NODE_ENV=dev
LOG_LEVEL=DEBUG
AWS_REGION=us-east-1

# Cognito User Pool (JWT verification)
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_USER_POOL_CLIENT_ID=your-app-client-id
COGNITO_USER_POOL_REGION=us-east-1

# Valkey / ElastiCache (JWKS cache)
ELASTICACHE_HOST=your-elasticache-host
ELASTICACHE_PORT=6379
ELASTICACHE_TTL=86400
ELASTICACHE_SLIDING_EXPIRATION=true
ELASTICACHE_USE_TLS=true
ELASTICACHE_CLUSTER_MODE=false
ELASTICACHE_REQUEST_TIMEOUT_MS=15000
ELASTICACHE_CONNECTION_TIMEOUT_MS=15000
