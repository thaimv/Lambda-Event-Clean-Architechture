# delete-user Lambda — environment variables
# Set on AWS Lambda (Console / CD). For local simulator: copy to out/simulator/env.yml under `local:`.

# Runtime
NODE_ENV=dev
LOG_LEVEL=DEBUG
AWS_REGION=us-east-1

# --- Database: local / test (NODE_ENV=local or test) ---
# Prisma reads DATABASE_URL directly — Secrets Manager is NOT used.
# DATABASE_URL=postgresql://user:password@localhost:5432/app?schema=public
# DATABASE_URL_REPLICA=postgresql://user:password@localhost:5432/app?schema=public

# --- Database: dev / stg / prd (NODE_ENV=dev|stg|prd) ---
# Prisma builds connection string from Secrets Manager + RDS Proxy.
# DATABASE_URL is NOT required on Lambda; set these instead:
RDS_PROXY_ENDPOINT=your-proxy.proxy-xxxxx.region.rds.amazonaws.com
RDS_PROXY_ENDPOINT_REPLICA=your-proxy-replica.proxy-xxxxx.region.rds.amazonaws.com
RDS_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:rds-credentials-xxxx
#
# Secret JSON (AWS RDS auto-generated) example:
# {
#   "username": "db_user",
#   "password": "********",
#   "engine": "postgres",
#   "host": "cluster.xxxxx.region.rds.amazonaws.com",
#   "port": 5432,
#   "dbname": "app",
#   "dbClusterIdentifier": "cluster-name"
# }
# Lambda IAM role needs: secretsmanager:GetSecretValue on RDS_SECRET_ARN

# Business rule
DELETE_USER_SOFT_DELETE_RETENTION_YEARS=1
