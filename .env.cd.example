# LambdaEvents — GitHub Environment deploy config (template)
#
# Do not commit this file with real values. Copy this checklist to GitHub:
#   Settings → Environments → event-develop | event-staging
#
# Workflow: .github/workflows/cd.yml
#   push develop        → event-develop
#   push staging/master → event-staging
#
# Infra must be deployed first from the cdk/ repo.
# auth-api (POST /auth/credential) is deployed from LambdaAPIs — not from this repo.
#
# ── Secret → GitHub Environment **Secrets** (not Variables) ──────────────────
AWS_ROLE_TO_ASSUME=arn:aws:iam::194130476852:role/REPLACE_ME-github-oidc-lambdaevents
#
# ── Vars → GitHub Environment **Variables** — required ─────────────────────
AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=194130476852
LAMBDA_ALIAS_NAME=live
#
# Lambda function names (CDK output *FnName)
LAMBDA_FUNCTION_JWT_AUTHORIZER_NAME=thaimv-dev-jwt-authorizer-function
LAMBDA_FUNCTION_DELETE_USER_NAME=thaimv-dev-delete-user-function
#
# Layers (CDK output PrismaLayerName / ElastiCacheLayerName)
PRISMA_LAYER_NAME=thaimv-dev-prisma-layer
ELASTICACHE_LAYER_NAME=thaimv-dev-elasticache-layer
#
# ── Vars — optional ───────────────────────────────────────────────────────
# Retains N most recent published versions for Lambda functions and layers (Prisma, ElastiCache).
KEEP_LAMBDA_VERSIONS=3
#
# Step Functions — leave empty to skip workflow deploy
STEP_FUNCTION_DELETE_USER_BATCH_NAME=thaimv-dev-delete-user-batch-sfn
#
# ── Lambdas deployed by cd.yml ─────────────────────────────────────────────
#   delete-user.zip    → LAMBDA_FUNCTION_DELETE_USER_NAME (+ prisma layer)
#   jwt-authorizer.zip → LAMBDA_FUNCTION_JWT_AUTHORIZER_NAME (+ elasticache layer)
#
# ── Deploy order ───────────────────────────────────────────────────────────
# 1. cdk deploy
# 2. set vars on event-develop
# 3. push develop → build + layers + deploy lambdas + Step Functions
