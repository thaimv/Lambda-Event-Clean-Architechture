# Copy to envs/.env.e2e before running E2E tests
# cp envs/.env.e2e.example envs/.env.e2e

# ── AWS credentials ────────────────────────────────────────────────────────────
# IAM credentials used to invoke Lambda and read CloudWatch Logs Live Tail.
# Needs: lambda:InvokeFunction, logs:StartLiveTail on relevant resources.
# Leave blank to rely on ambient credentials (SSO / instance profile / env).
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Lambda ARNs ────────────────────────────────────────────────────────────────
# Full ARN (or function name) of each Lambda to invoke in E2E tests.
DELETE_USER_LAMBDA_ARN=arn:aws:lambda:eu-west-2:123456789012:function:project-dev-delete-user-func
JWT_AUTHORIZER_LAMBDA_ARN=arn:aws:lambda:eu-west-2:123456789012:function:project-dev-jwt-authorizer-func

# ── CloudWatch Log Group ARNs ──────────────────────────────────────────────────
# ARN of the Lambda's CloudWatch log group — used by LiveTail to capture logs
# during the test run and assert no sensitive data is leaked.
# Format: arn:aws:logs:<region>:<account>:log-group:/aws/lambda/<function-name>
DELETE_USER_LAMBDA_LOG_GROUP_ARN=arn:aws:logs:eu-west-2:123456789012:log-group:/aws/lambda/project-dev-delete-user-func
JWT_AUTHORIZER_LAMBDA_LOG_GROUP_ARN=arn:aws:logs:eu-west-2:123456789012:log-group:/aws/lambda/project-dev-jwt-authorizer-func

# ── CloudWatch tuning ──────────────────────────────────────────────────────────
# Seconds to wait after Lambda invocation before stopping LiveTail and asserting.
# Increase if logs arrive late (slow cold starts, VPC Lambdas).
CLOUDWATCH_LOG_FLUSH_WAIT=20

# ── Database (Prisma) ──────────────────────────────────────────────────────────
# Direct connection URL for E2E DB assertions (bypasses Secrets Manager).
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public

# ── Cognito (optional) ─────────────────────────────────────────────────────────
# jwt-authorizer S01/S02: set E2E_COGNITO_ID_TOKEN and/or TEST_USER_* + pool/client below.
# GraphQL / REST API tests: full Cognito + identity pool + API URLs.
COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_IDENTITY_POOL_ID=eu-west-2:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TEST_USER_USERNAME=test@example.com
TEST_USER_PASSWORD=
# Pre-issued Cognito idToken for jwt-authorizer happy-path E2E (skips live login)
E2E_COGNITO_ID_TOKEN=

# ── API endpoints (optional — only needed for GraphQL / REST API tests) ────────
GRAPHQL_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxx.appsync-api.eu-west-2.amazonaws.com/graphql
PUBLIC_API_BASE_URL=https://xxxxxxxxxx.execute-api.eu-west-2.amazonaws.com/v1
AUTH_API_BASE_URL=https://xxxxxxxxxx.execute-api.eu-west-2.amazonaws.com/v1
