{
  "name": "lambda-event",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "app/lambda/src/delete-user",
    "app/lambda/src/jwt-authorizer"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest -c vitest.config.mjs",
    "test:update": "vitest -u",
    "test:ci": "vitest run -c vitest.config.mjs --coverage",
    "test:coverage": "vitest -c vitest.config.mjs --coverage",
    "test:e2e": "vitest -c vitest-e2e.config.mjs",
    "test:e2e:ci": "vitest run -c vitest-e2e.config.mjs",
    "lint": "eslint .",
    "lint:test": "eslint app/lambda/",
    "lint:exclude_test": "eslint . --ignore-pattern app/lambda/ --max-warnings=0",
    "lint:ci": "npm run lint:test && npm run lint:exclude_test",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:ci": "prettier . --check",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "validate": "node -e \"const fs=require('fs');const red='\\x1b[31m';const reset='\\x1b[0m';const green='\\x1b[32m';const errors=[];if(!fs.existsSync('node_modules')){errors.push('Missing node_modules — run npm install');}if(errors.length>0){console.error(red+'Validation failed:'+reset);errors.forEach(e=>console.error(red+'- '+e+reset));process.exit(1);}else{console.log(green+'Validation passed.'+reset);}\"",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "prisma:generate": "bash app/lambda/layer/prisma/generate-to-root.sh",
    "build:delete-user": "node deploy/scripts/bundle.js delete-user",
    "build:jwt-authorizer": "node deploy/scripts/bundle.js jwt-authorizer",
    "build:all:lambdas": "node deploy/scripts/build-all-lambdas.js",
    "build:lambdas": "bash deploy/scripts/003_build-lambdas-from-config.sh @deploy/lambdas.config.json"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1068.0",
    "@aws-sdk/client-cognito-identity": "^3.1068.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1068.0",
    "@smithy/protocol-http": "^5.4.7",
    "@smithy/signature-v4": "^5.4.7",
    "@types/node": "22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.2.0",
    "@vitest/coverage-v8": "^2.1.3",
    "axios": "^1.17.0",
    "esbuild": "^0.24.2",
    "esbuild-plugin-tsc": "^0.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.6.2",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.891.0",
    "@aws-sdk/client-cloudwatch": "^3.726.1",
    "@aws-sdk/client-lambda": "^3.1058.0",
    "@aws-sdk/client-secrets-manager": "^3.1058.0",
    "@aws-sdk/client-ses": "^3.882.0",
    "@aws-sdk/client-sfn": "^3.525.0",
    "@aws-sdk/client-sqs": "^3.1058.0",
    "@aws-sdk/client-sts": "^3.1058.0",
    "@aws-sdk/client-translate": "^3.1058.0",
    "@aws-sdk/lib-dynamodb": "^3.1058.0",
    "@aws-sdk/lib-storage": "^3.821.0",
    "@dsnp/parquetjs": "^1.8.7",
    "@google-cloud/storage": "^7.19.0",
    "@prisma/client": "^6.6.0",
    "@prisma/extension-read-replicas": "^0.4.1",
    "@valkey/valkey-glide": "^2.4.1",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.4.3",
    "csv-parse": "^6.2.1",
    "dayjs": "^1.11.21",
    "google-auth-library": "^10.7.0",
    "graphql": "^16.10.0",
    "inversify": "^6.2.2",
    "prisma": "^6.6.0",
    "reflect-metadata": "^0.2.2",
    "source-map-support": "^0.5.21",
    "zod": "^3.24.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "npm run lint:fix",
      "npm run format"
    ]
  }
}
